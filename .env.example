# Production requires unique, high-entropy values for every secret below.
POSTGRES_DB=scalper
POSTGRES_USER=scalper
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

SCALPER_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SCALPER_SESSION_SECRET=replace-with-at-least-32-random-bytes
SCALPER_COOKIE_SECURE=1

# 2026-09-26 denetim (#105): A2A_SHARED_SECRET / A2A_RELAY_URL / A2A_PEER_URL /
# SCALPER_A2A_URL değişkenleri BURADAN SİLİNDİ.
#
# Gerekçe: A2A (agent-to-agent) modülü tamamen kaldırılmış; `backend/app/`
# altında "A2A" geçen HİÇBİR Python dosyası yok (grep ile doğrulandı). Bu
# dört satır ölüydü. Özellikle `A2A_SHARED_SECRET` orada bırakmak kullanıcıya
# YANLIŞ güvenlik izlenimi veriyordu — sanki bir kimlik doğrulama katmanı
# varmış gibi. Artık A2A için yapılandırılacak bir şey yoktur.
#
# Gerçek üretim kapısı `SCALPER_ENV=production` ile admin parola politikasının
# UYGULANMASIDIR (bkz. docker-compose.yaml ve config.py:751).

# Custom private/LAN providers are rejected unless this is explicitly 1.
LLM_ALLOW_PRIVATE_PROVIDER=0
LLM_ENCRYPTION_KEY=

VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

TOP_GAINERS_AUTO_ACTIVATE=true
TOP_GAINERS_LIMIT=10
TOP_GAINERS_REFRESH_SEC=600

# ═════════════════════════════════════════════════════════════════════════
# BİNANCE GLOBAL ÖRNEĞİ (USDT) — 2026-09-26
# ═════════════════════════════════════════════════════════════════════════
# Aynı kod tabanının ikinci dağıtımı: `api.binance.com` + USDT. Ayrı DB,
# ayrı postgres konteyneri, ayrı frontend build'i (NEXT_PUBLIC_* build-time).
#
# Yalnız Global örneğini çalıştıracaksanız TR değişkenlerini de doldurmanız
# gerekir — compose dosyasındaki `:?` kontrolleri eksikleri başlangıçta
# YAPILANDIRMA HATASI olarak (çökme yerine) bildirir.
#
# ⚠️ SCALPER_SESSION_SECRET_GLOBAL, TR'den FARKLI olmak ZORUNDA. Aynı secret
#    iki örnek arasında oturum çerezini geçerli kılar; iki ayrı kullanıcı
#    tablosu varken bu bir yetki karışıklığıdır.
#    Üretin: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
#
# ⚠️ POSTGRES_DB_GLOBAL, backend'in `DATABASE_URL`'inde gösterdiği isimle
#    AYNI olmalı. Farklıysa backend kendi tablolarını bulamaz.
POSTGRES_DB_GLOBAL=scalper_global
POSTGRES_USER_GLOBAL=scalper
# Boş bırakılırsa POSTGRES_PASSWORD'a düşer. Ayrı parola tercih edilir.
POSTGRES_PASSWORD_GLOBAL=replace-with-a-different-long-random-database-password

SCALPER_ADMIN_PASSWORD_GLOBAL=replace-with-a-strong-admin-password
SCALPER_SESSION_SECRET_GLOBAL=replace-with-a-DIFFERENT-32-plus-byte-random-value
# Boş bırakılırsa LLM_ENCRYPTION_KEY'e düşer. Provider API anahtarları
# ortak kullanılabilir; anahtarların ŞİFRESİ aynı da olabilir.
LLM_ENCRYPTION_KEY_GLOBAL=

# Global dağıtımın domain'i. Traefik TLS'i sonlandırıp gateway_global'e
# yönlendirir; tarayıcı origin'i bu adres olur.
# Boş bırakılırsa compose varsayılanı BU DEĞER olur (localhost'a düşmez).
CORS_ORIGINS_GLOBAL=https://global.erkanerdem.online

# Likidite tabanı (USDT). Global'de ölçüldü: 20K/50K/120K/300K tabanlarının
# hepsinde tarama havuzu 10 kazanan / 8 hareketli çıktı.
MIN_QUOTE_VOLUME_USDT=120000
# Balina tespiti eşiği (USDT cinsinden nominal).
WHALE_NOTIONAL=25000

# ═════════════════════════════════════════════════════════════════════════
# BİNANCE TR LEAD-LAG SIGNAL BRIDGE (2026-09-28)
# ═════════════════════════════════════════════════════════════════════════
# Global'deki hareketler Binance TR'den birkaç saniye önce başlar.
# Global'de üretilen radar, hızlı, velocity veya push sinyalleri bu köprü üzerinden
# Binance TR klonundaki alıcı webhook uç noktasına HTTP POST olarak iletilir.
BINANCE_TR_BRIDGE_ENABLED=true
BINANCE_TR_BRIDGE_URL=https://scalper.erkanerdem.online/api/bridge/global-signal
BINANCE_TR_BRIDGE_SECRET=replace-with-a-secure-bridge-secret-key
BINANCE_TR_BRIDGE_TIMEOUT=3.0
BINANCE_TR_BRIDGE_MIN_SCORE=0.0
BINANCE_TR_BRIDGE_COOLDOWN_SEC=10.0

